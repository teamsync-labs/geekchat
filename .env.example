# ===== DOCKER IMAGES =====
IMAGE_PREFIX=geekchat
IMAGE_TAG=latest

COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# ===== POSTGRESQL =====
POSTGRES_USER=geekchat
POSTGRES_PASSWORD=geekchat
POSTGRES_DB=geekchat
# optional full URL; otherwise set for local compose:
DATABASE_URL=postgresql+asyncpg://geekchat:geekchat@db:5432/geekchat

# ===== BACKEND =====
# публичный URL приложения (join_url и т.п.)
BASE_URL=http://127.0.0.1:8089

# ===== AUTH (JWT) =====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== ENTRY (compose-nginx) =====
NGINX_PORT=8089
NGINX_BIND=0.0.0.0
ACCESS_VIA_DOMAIN=false
APP_DOMAIN=geek-chat.ru
HEALTHCHECK_URL=http://127.0.0.1:8089/health
APP_PUBLIC_URL=http://127.0.0.1:8089
